# OS
.DS_Store

# Playwright browsers are installed globally, not vendored
ms-playwright/

# Local flow recipes are runtime artifacts (keep the example, ignore the rest)
flows/*.json
!flows/calc_12x34.json

# Proposals the screen loop filed after a run. Machine output about
# one person's screen, not source — and deliberately not where
# anything replays from.
flows/_candidates/

# Probe output: run logs, JSON reports and screenshots of one person's screen.
# Machine output about a machine, not source. The findings that mattered are
# written up in PROTOCOL.md instead, where they stay readable without 126MB.
reviews/
